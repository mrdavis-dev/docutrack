DATABASE_URL=postgresql://docucars:docucars@db:5432/docucars
BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM=noreply@tuempresa.com
SMTP_FROM_NAME=DocuCars
BUSINESS_EMAIL=admin@tuempresa.com
UPLOAD_DIR=/app/uploads
SLA_MINUTES=60
SLA_CHECK_INTERVAL=300
# comma-separated list of allowed frontend origins
CORS_ORIGINS_RAW=https://app.tuempresa.com
ENV=development

# Only read once, by migration 0005, to create the first admin account in the DB.
# Not used anywhere else — every account after that is created via POST /users.
# Override before running `alembic upgrade head` on a fresh database; if left at the
# defaults, change the password immediately after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
